# Copy to `.env` on the VM (or pass as --env-file to Docker) and fill in real
# values. Never commit the filled-in version.
#
# Not every script needs every key — see each script's own header comment for
# which ones it actually reads. This is the union across all of them.

# ── Required by nearly everything (Tier 1 + 1b + 2 + 3) ─────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Required by the Claude-based enrichment scripts (Tier 2 + 3) ────────────
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-haiku-4-5-20251001

# ── Required by backfill_embeddings.ts (Tier 1b) ────────────────────────────
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536

# ── Search providers for the scraping scripts (Tier 2 + 3) ──────────────────
# TAVILY_API_KEY is optional — Serper (or DuckDuckGo, in autopilot.ts) is the
# fallback if it's absent.
TAVILY_API_KEY=
SERP_KEY=

# ── Identify the bot to any site operator who notices the traffic ───────────
SEC_USER_AGENT=AlphaMapEnrichmentBot/1.0 (+contact: you@yourdomain.com)

# ── Common run-tuning knobs (safe defaults already baked into the scripts —
#    override only if you know you want to) ─────────────────────────────────
DRY_RUN=true
BATCH_SIZE=300
OFFSET=0
DELAY_MS=15000
MIN_CONFIDENCE=40
MAX_TIER=2
