# Environment variables for the AI-powered Supabase Edge Functions
# (chat-analyst, answer-query, ingest-startup, semantic-search,
# backfill-embeddings). Set these as Supabase secrets — via the Dashboard
# (Edge Functions -> Manage secrets) or `supabase secrets set KEY=value` —
# never as a committed .env file; this file documents what's required, it
# isn't loaded by anything.
#
# Not every function needs every key — see each function's own header
# comment (the "Secrets:" line) for exactly which ones it reads. This is
# the union across all five.

# ── Self-hosted LLM (chat-analyst, answer-query, ingest-startup) ────────────
# Our own fine-tuned model, served by vLLM's OpenAI-compatible API on the
# GCP VM — replaces the Anthropic API these functions used previously (see
# supabase/functions/_shared/llm-client.ts for the request/response
# translation layer).
#
# SELF_HOSTED_LLM_URL is the base URL only — the client appends
# "/v1/chat/completions" itself. No trailing slash needed either way.
SELF_HOSTED_LLM_URL=https://your-vllm-host.example.com
SELF_HOSTED_LLM_KEY=

# Default model name sent in every request's "model" field, when a
# function-specific override below isn't set. Must match whatever model
# name vLLM was launched with (`--served-model-name`).
SELF_HOSTED_LLM_MODEL=

# ── Per-function overrides (all optional — fall back to SELF_HOSTED_LLM_MODEL
#    and the defaults noted, if unset) ───────────────────────────────────────
CHAT_ANALYST_MODEL=
CHAT_ANALYST_MAX_TOKENS=1500
CHAT_ANALYST_MAX_ITERATIONS=4

ANSWER_MODEL=
ANSWER_MAX_TOKENS=1200

INGEST_STARTUP_MODEL=

# ── Self-hosted embeddings (semantic-search, backfill-embeddings, and
#    chat-analyst's semantic_search tool) ────────────────────────────────────
# Text Embeddings Inference (TEI) serving nomic-ai/nomic-embed-text-v1.5
# (768-d), on the same RunPod instance as the self-hosted LLM above, on its
# own port (8080) — see supabase/functions/_shared/tei-client.ts. Replaces
# the OpenAI embeddings call these functions used previously; the
# self-hosted LLM above doesn't serve embeddings, so this is a separate
# endpoint regardless of the chat-completion swap above.
#
# RUNPOD_TEI_URL is the base URL only — clients append "/v1/embeddings"
# themselves. No trailing slash needed either way.
RUNPOD_TEI_URL=https://your-pod-id-8080.proxy.runpod.net

# Optional — a private RunPod proxy URL has no auth in front of it unless you
# put one there. Leave unset if yours doesn't. In chat-analyst, missing
# RUNPOD_TEI_URL degrades its semantic_search tool gracefully rather than
# failing the whole conversation; semantic-search/backfill-embeddings require it.
RUNPOD_TEI_KEY=

# ingest-startup's web research step.
TAVILY_API_KEY=

# ── Platform-injected — do not set these yourself ────────────────────────────
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
