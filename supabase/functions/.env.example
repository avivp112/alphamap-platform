# Environment variables for the AI-powered Supabase Edge Functions
# (chat-analyst, answer-query, ingest-startup). Set these as Supabase
# secrets — via the Dashboard (Edge Functions -> Manage secrets) or
# `supabase secrets set KEY=value` — never as a committed .env file; this
# file documents what's required, it isn't loaded by anything.
#
# Not every function needs every key — see each function's own header
# comment (the "Secrets:" line) for exactly which ones it reads. This is
# the union across all three.

# ── Self-hosted LLM (chat-analyst, answer-query, ingest-startup) ────────────
# Our own fine-tuned model, served by vLLM's OpenAI-compatible API on the
# GCP VM — replaces the Anthropic API these functions used previously (see
# supabase/functions/_shared/llm-client.ts for the request/response
# translation layer).
#
# SELF_HOSTED_LLM_URL is the base URL only — the client appends
# "/v1/chat/completions" itself. No trailing slash needed either way.
SELF_HOSTED_LLM_URL=https://your-vllm-host.example.com
SELF_HOSTED_LLM_KEY=

# Default model name sent in every request's "model" field, when a
# function-specific override below isn't set. Must match whatever model
# name vLLM was launched with (`--served-model-name`).
SELF_HOSTED_LLM_MODEL=

# ── Per-function overrides (all optional — fall back to SELF_HOSTED_LLM_MODEL
#    and the defaults noted, if unset) ───────────────────────────────────────
CHAT_ANALYST_MODEL=
CHAT_ANALYST_MAX_TOKENS=1500
CHAT_ANALYST_MAX_ITERATIONS=4

ANSWER_MODEL=
ANSWER_MAX_TOKENS=1200

INGEST_STARTUP_MODEL=

# ── Still required — unrelated to the LLM swap ───────────────────────────────
# chat-analyst's semantic_search tool embeds the query via OpenAI directly
# (text-embedding-3-small) — the self-hosted LLM doesn't serve embeddings,
# so this stays a real OpenAI key regardless of the chat-completion swap
# above. Missing it degrades semantic_search gracefully rather than failing
# the whole conversation.
OPENAI_API_KEY=

# ingest-startup's web research step.
TAVILY_API_KEY=

# ── Platform-injected — do not set these yourself ────────────────────────────
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
